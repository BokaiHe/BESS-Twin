{
  "name": "bess-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "node scripts/simulation-report.mjs",
    "build:pages": "tsc -b && vite build --mode pages",
    "cabinet:build": "node scripts/build-cabinet.mjs --audit",
    "cell:build": "node scripts/build-cell.mjs --audit",
    "cell:orbit-audit": "node scripts/audit-cell-orbit.mjs",
    "renewables:build": "node scripts/build-renewables.mjs --audit",
    "explorers:previews": "node scripts/capture-explorer-previews.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
